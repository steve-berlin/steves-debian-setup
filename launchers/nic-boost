#!/usr/bin/env bash
# nic-boost — a temporary speed-up for the network card (NIC), meant to be
# switched on for one bandwidth-heavy job and then forgotten.
#
# The trade it makes: network hardware saves power by napping.
#   WiFi "power save": in the gaps between packets the chip turns the
#     radio off for a few milliseconds.
#   Ethernet EEE (Energy-Efficient Ethernet): the same idea for the cable
#     when the link is quiet.
# Waking up takes a little time. It lands as a small delay at the front of
# every burst of traffic, which you notice on a big download or a video
# call. nic-boost turns the napping off, on every detected interface.
# Faster response, a bit more battery drain: roughly 0.3–0.5 W for the WiFi
# radio, about 0.5 W for an idle ethernet link.
# That cost is highest exactly when traffic is low, i.e. when the boost is
# useless. So it is an opt-in per session, not a permanent setting. (The
# old permanent install-nic-tuning.sh left this repo in 7d67a4e, with the
# gaming scripts.)
#
# How to use it:
#   nic-boost                  on; stays on until reboot
#   nic-boost <command...>     on, run the command, off again when it exits
#   nic-boost --off            off (back to driver defaults)
# The middle form is the good one, e.g.
#   nic-boost yt-dlp https://example.com/big-video
#
# Why you can't break anything with it: both settings are runtime-only.
# No config file, no modprobe option, no NetworkManager dispatcher hook is
# written. The kernel holds them in memory and forgets them on reboot.
# So there are three ways back to normal:
#   - reboot
#   - the wrapped command exits, if invoked as `nic-boost <command...>`
#   - `nic-boost --off` (manual revert)
#
# Needs sudo: changing hardware settings requires root. It asks for your
# password when needed.
#
# Exit code: with a command, whatever the command returned (so
# `nic-boost make test` fails when the tests fail). Without one, 0.

# set -e: stop at the first command that fails.
# set -u: treat a typo'd (unset) variable name as an error.
# set -o pipefail: a pipe fails if any command in it fails, not just the last.
set -euo pipefail

# mode=on (default) applies the boost. A first argument of --off sets
# mode=off and drops that argument. Anything after --off is ignored.
mode=on
if [[ ${1:-} == --off ]]; then mode=off; shift; fi
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  cat <<EOF
Usage:
  nic-boost                 apply boost; revert on reboot
  nic-boost <command...>    apply boost, run command, revert on its exit
  nic-boost --off           revert manually (back to defaults)
EOF
  exit 0
fi

# Find the network cards. The kernel lists every interface as a folder in
# /sys/class/net/. Skip the ones that aren't real hardware: loopback (lo),
# virtual machine interfaces (vir*), Docker's bridges (docker*, br-*).
# Then sort the rest:
#   wifi: has a "wireless" subfolder.
#   eth:  anything else with a hardware driver (device/driver exists).
#         VPN tunnels (e.g. nordlynx) have no driver link, so they are
#         left out on their own.
# Nothing to configure: works with both, one, or oddly named cards.
eth=() wifi=()
for i in /sys/class/net/*; do
  n=${i##*/}
  [[ $n == lo || $n == vir* || $n == docker* || $n == br-* ]] && continue
  if [[ -d $i/wireless ]]; then wifi+=("$n")
  elif [[ -e $i/device/driver ]]; then eth+=("$n"); fi
done

# set_nic on|off: set WiFi power_save and ethernet EEE to the same value.
# The words read backwards: `off` boosts (kills idle napping), `on` = default.
# You are turning power SAVING off, not the network.
# Every change is allowed to fail quietly (`2>/dev/null || true`). Many
# ethernet chips have no EEE at all; that is not an error. If iw is not
# installed, the WiFi part is skipped. If ethtool is missing, the ethernet
# part fails just as quietly.
set_nic() {
  local st=$1 n
  for n in "${wifi[@]}"; do
    command -v iw >/dev/null && sudo iw dev "$n" set power_save "$st" 2>/dev/null || true
  done
  for n in "${eth[@]}"; do
    sudo ethtool --set-eee "$n" eee "$st" 2>/dev/null || true
  done
}

# --off: put both knobs back to their defaults and stop.
if [[ $mode == off ]]; then
  set_nic on
  echo "nic-boost off (wifi power_save=on, eee=on)"
  exit 0
fi

# Apply the boost, and print which cards got it, e.g.
#   nic-boost on  (wifi power_save=off, eee=off — eth: enp0s31f6  wifi: wlp3s0)
set_nic off
echo "nic-boost on  (wifi power_save=off, eee=off — eth: ${eth[*]:-none}  wifi: ${wifi[*]:-none})"

# With a command: run it, and revert when the script exits. The trap
# fires on any exit (EXIT), Ctrl-C (INT) or kill (TERM). So the revert is
# tied to the script ending, not to the command succeeding: a crash or
# Ctrl-C still snaps the settings back. If the command fails, set -e ends
# the script with the command's exit code.
# Without a command: leave the boost on.
if (( $# > 0 )); then
  trap 'set_nic on' EXIT INT TERM
  "$@"
else
  echo "(reverts on reboot; or run 'nic-boost --off' to revert manually)"
fi
