#!/usr/bin/env bash
# rbxvm — boot the LineageOS-style (Android-x86) VM for Roblox.
# Mirrors stm/rbx/skl: stop TLP, drop swappiness, pin governor to
# performance, then exec qemu under KVM.
#
# Resources are deliberately tight (Roblox is the only workload):
#   4 vCPU, 4 GiB RAM, 8 GiB qcow2 disk (sparse).
# The host iGPU (T480 UHD 620) is the real ceiling, not these numbers.
set -euo pipefail

VM_DIR="${LINEAGE_VM_DIR:-$HOME/lineage_vm}"
DISK="$VM_DIR/disk.qcow2"
ISO="$VM_DIR/android-x86.iso"
RAM_MB=4096
VCPUS=4
ADB_HOST_PORT=5555

# sysctl and cpupower live in /sbin and aren't on the user PATH, but they're
# only invoked through sudo (which uses root's PATH). Only check tools that
# this script calls directly.
for cmd in qemu-system-x86_64 qemu-img sudo systemctl stat; do
  command -v "$cmd" >/dev/null \
    || { echo "error: $cmd not found in PATH — run install-lineage.sh" >&2; exit 1; }
done
[[ -e /dev/kvm ]] \
  || { echo "error: /dev/kvm missing (BIOS virtualization disabled?)" >&2; exit 1; }
[[ -s $DISK ]] \
  || { echo "error: $DISK missing — run install-lineage.sh first" >&2; exit 1; }

# adb is only needed for the Roblox autostart. Warn but don't fail —
# autostart is opt-out (RBXVM_NO_AUTOSTART=1), and the user may install
# adb later or intentionally skip it.
have_adb=1
if ! command -v adb >/dev/null; then
  have_adb=0
  [[ ${RBXVM_NO_AUTOSTART:-0} != 1 ]] \
    && echo "warning: 'adb' not on PATH — Roblox autostart will be skipped." >&2
fi

# Perf profile — identical to stm/rbx/skl. Skipped under RBXVM_DRY=1 because
# the sudo calls would block on a password prompt in non-TTY contexts
# (smoke tests, CI). The dry-run output below is the only thing tests
# need; perf tweaks aren't observable from there anyway.
if [[ ${RBXVM_DRY:-0} != 1 ]]; then
  sudo systemctl stop tlp 2>/dev/null || true
  sudo sysctl -q vm.swappiness=10
  sudo cpupower frequency-set -g performance >/dev/null 2>&1
fi

# On first boot the qcow2 is empty (~200 KB of metadata, no real data). Once
# Android-x86 is installed to disk the file grows past a megabyte. We use
# that file-size heuristic to decide whether to attach the install ISO and
# bias GRUB toward the CD-ROM ('-boot order=dc'). After install, omitting
# the cdrom prevents users from accidentally rebooting back into the
# installer (which would wipe their guest setup).
cdrom_args=()
if (( $(stat -c%s "$DISK") < 1048576 )); then
  [[ -s $ISO ]] \
    || { echo "error: $ISO missing — run install-lineage.sh first" >&2; exit 1; }
  cdrom_args=(-cdrom "$ISO" -boot order=dc,menu=on)
  echo "First boot — booting from ISO. Pick 'Installation' in the GRUB menu."
fi

# RBXVM_DRY=1 prints the qemu command and exits without launching — used by
# the install smoke test.
qemu=(
  qemu-system-x86_64
  -enable-kvm -cpu host -smp "$VCPUS" -m "$RAM_MB"
  -machine q35
  -drive file="$DISK",if=virtio,format=qcow2,discard=unmap
  -device virtio-vga-gl -display gtk,gl=on
  -device virtio-tablet -device virtio-keyboard
  -audiodev pa,id=snd0 -device intel-hda -device hda-output,audiodev=snd0
  -netdev user,id=net0,hostfwd=tcp:127.0.0.1:$ADB_HOST_PORT-:5555
  -device virtio-net,netdev=net0
  -name "LineageOS (Roblox VM)"
  "${cdrom_args[@]}"
)

if [[ ${RBXVM_DRY:-0} == 1 ]]; then
  printf '%q ' "${qemu[@]}"; echo
  exit 0
fi

# Background ADB autostart of Roblox. Best-effort: polls the forwarded
# port for ~180 s, then `monkey`-launches the package via its LAUNCHER
# intent. On first-boot (empty qcow2) or before ADB-over-network is
# enabled inside the guest, it just times out cleanly — harmless.
# Disable with RBXVM_NO_AUTOSTART=1; override the package with RBXVM_AUTOSTART_PKG.
autostart_roblox() {
  local pkg=${RBXVM_AUTOSTART_PKG:-com.roblox.client} host=127.0.0.1:$ADB_HOST_PORT
  for _ in {1..60}; do
    sleep 3
    adb connect "$host" >/dev/null 2>&1 \
      && adb -s "$host" shell pm list packages "$pkg" 2>/dev/null | grep -q "$pkg" \
      && exec adb -s "$host" shell monkey -p "$pkg" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
  done
  echo "warning: Roblox autostart timed out — ADB-over-network enabled in guest?" >&2
}

if (( have_adb )) && [[ ${RBXVM_NO_AUTOSTART:-0} != 1 ]]; then
  trap 'kill 0 2>/dev/null || true' EXIT
  "${qemu[@]}" & qpid=$!
  autostart_roblox &
  wait "$qpid"
else
  exec "${qemu[@]}"
fi
