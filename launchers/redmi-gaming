#!/usr/bin/env bash
# Re-exec under bash if invoked as `sh redmi-gaming` — uses bashisms.
if [ -z "${BASH_VERSION:-}" ]; then
  exec /usr/bin/env bash "$0" "$@"
fi
# redmi-gaming — toggle a per-session gaming profile on a connected Redmi 4A
# (rolex) via ADB. Apply/revert pattern, same shape as nic-boost. Non-root
# tweaks always run; CPU governor + GPU max run only if root is available
# (LineageOS Developer Options → "Rooted debugging" or Magisk's su).
# See CLAUDE.md "launchers/" → "redmi-gaming" for the per-knob rationale.
set -euo pipefail

DEVICE_CODENAME=rolex
# Heavy background services to force-stop before a game session. Edit to taste.
# (Listed apps are no-ops if not installed — vending is GApps-only.)
HEAVY=(com.google.android.gms com.android.vending)

mode=on; dry=0
for a in "$@"; do
  case $a in
    --off)     mode=off ;;
    --dry-run) dry=1 ;;
    -h|--help)
      cat <<EOF
Usage: $0 [--off] [--dry-run]
  bare      apply gaming profile (animations 0.5x, low_power off, HEAVY apps
            stopped, CPU/GPU performance if root); persists until --off.
  --off     revert to LineageOS defaults.
EOF
      exit 0 ;;
    *) echo "error: unknown arg: $a" >&2; exit 2 ;;
  esac
done

run() { (( dry )) && printf 'DRY  adb shell %s\n' "$*" || adb shell "$@"; }
# root-only; prints a skip line (with note) and returns 0 if not available so
# the rest of the script keeps running.
runr() {
  if ! (( has_root )); then echo "skip (root needed): $*"; return 0; fi
  (( dry )) && printf 'DRY  adb shell su -c %s\n' "$*" || adb shell "su -c '$*'"
}

# Preflight: adb, exactly one device, codename = rolex.
command -v adb >/dev/null || { echo "missing: adb (apt install adb)" >&2; exit 1; }
mapfile -t devs < <(adb devices | awk 'NR>1 && $2=="device" {print $1}')
[[ ${#devs[@]} -eq 1 ]] \
  || { echo "error: need exactly one authorized device (got ${#devs[@]})" >&2; exit 1; }
actual=$(adb shell getprop ro.product.device 2>/dev/null | tr -d '\r')
[[ $actual == "$DEVICE_CODENAME" ]] \
  || { echo "error: device '$actual' != '$DEVICE_CODENAME', refusing." >&2; exit 1; }

# Detect root via Magisk's su first (doesn't change adbd uid). Fall back to
# `adb root`, which only works if LOS Developer Options → "Rooted debugging"
# is enabled — and which restarts adbd, so skip it under --dry-run to keep
# the dry-run truly side-effect-free.
has_root=0
if [[ "$(adb shell su -c id 2>/dev/null)" == *"uid=0"* ]]; then
  has_root=1
elif (( ! dry )) && adb root >/dev/null 2>&1 \
     && [[ "$(adb shell id 2>/dev/null)" == *"uid=0"* ]]; then
  has_root=1
fi
(( has_root )) && echo "[root: available]" \
              || echo "[root: not available — skipping governor/GPU tweaks]"

if [[ $mode == on ]]; then
  # Animation scales — biggest perceived-perf win on a 2 GB-RAM phone with a
  # 425 SoC. 0.5 instead of 0 keeps animations legible so you can still see
  # the touch-target feedback during a game.
  for k in window_animation_scale transition_animation_scale animator_duration_scale; do
    run "settings put global $k 0.5"
  done
  # LineageOS battery saver throttles CPU + bg sync — bail out of it explicitly.
  run "settings put global low_power 0"
  # Force-stop heavy bg services so they don't contend at game start.
  for p in "${HEAVY[@]}"; do run "am force-stop $p" || true; done
  # Root-only: pin all CPUs to `performance` and GPU governor to `performance`.
  # The Snapdragon 425's interactive/schedutil ramp is conservative enough to
  # cost frames in a touch-heavy game; performance pins the max OPP.
  runr 'for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$c"; done'
  runr 'echo performance > /sys/class/kgsl/kgsl-3d0/devfreq/governor 2>/dev/null || true'
  echo "── done ── revert with: $0 --off"
else
  for k in window_animation_scale transition_animation_scale animator_duration_scale; do
    run "settings put global $k 1.0"
  done
  # Restore stock rolex governors: schedutil on CPU (LOS 18+), msm-adreno-tz
  # on GPU. Fall back to `interactive` if schedutil is missing (older LOS).
  runr 'for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo schedutil > "$c" 2>/dev/null || echo interactive > "$c"; done'
  runr 'echo msm-adreno-tz > /sys/class/kgsl/kgsl-3d0/devfreq/governor 2>/dev/null || true'
  echo "── done ── reverted to LineageOS defaults."
fi
