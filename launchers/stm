#!/usr/bin/env bash
set -e

STEAM_LIB=/games/steam
VDF=/home/fred/.steam/debian-installation/steamapps/libraryfolders.vdf

if [ ! -d "$STEAM_LIB" ]; then
    echo "error: $STEAM_LIB not mounted" >&2
    exit 1
fi

if ! pgrep -x steam >/dev/null && [ -f "$VDF" ] && ! grep -qF "\"$STEAM_LIB\"" "$VDF"; then
    python3 - "$VDF" "$STEAM_LIB" <<'PY'
import re, sys, pathlib
vdf_path, lib = sys.argv[1], sys.argv[2]
text = pathlib.Path(vdf_path).read_text()
indices = [int(m.group(1)) for m in re.finditer(r'"(\d+)"\s*\{', text)]
next_idx = (max(indices) + 1) if indices else 0
entry = (
    f'\t"{next_idx}"\n'
    f'\t{{\n'
    f'\t\t"path"\t\t"{lib}"\n'
    f'\t\t"label"\t\t""\n'
    f'\t\t"contentid"\t\t"0"\n'
    f'\t\t"totalsize"\t\t"0"\n'
    f'\t\t"update_clean_bytes_tally"\t\t"0"\n'
    f'\t\t"time_last_update_verified"\t\t"0"\n'
    f'\t\t"apps"\n'
    f'\t\t{{\n'
    f'\t\t}}\n'
    f'\t}}\n'
)
new = text[::-1].replace('}', entry[::-1] + '}', 1)[::-1]
pathlib.Path(vdf_path).write_text(new)
PY
    echo "added $STEAM_LIB as Steam library folder"
fi

sudo systemctl stop tlp
sudo sysctl vm.swappiness=10
sudo cpupower frequency-set -g performance
exec steam "$@"
