#!/usr/bin/env bash
# rbx — launch Roblox in Waydroid with T480 performance tweaks.
# Mirrors the pattern of ~/.local/bin/stm and the `skl` alias in ~/.zshrc:
# stop TLP, drop swappiness, pin governor to performance, then launch.
set -euo pipefail

PKG=${RBX_PKG:-com.roblox.client}
WAYLAND_SOCKET=wayland-1

for cmd in waydroid sudo systemctl; do
  command -v "$cmd" >/dev/null \
    || { echo "error: $cmd not found in PATH" >&2; exit 1; }
done

# Helper: succeeds iff the user-side waydroid session is RUNNING.
# `waydroid status` is the only valid status command — `waydroid session`
# only accepts start/stop, not status.
session_running() {
  waydroid status 2>/dev/null | grep -qE "^Session:[[:space:]]+RUNNING"
}

# 1. system container (started once, stays up until reboot)
if ! systemctl is-active --quiet waydroid-container; then
  sudo systemctl start waydroid-container
fi

# 2. perf profile — identical to stm/skl
sudo systemctl stop tlp
sudo sysctl vm.swappiness=10
sudo cpupower frequency-set -g performance

# 3. X11 hosts need a nested Wayland compositor; on Wayland this is a no-op.
#    Must run BEFORE step 4: `waydroid session start` reads WAYLAND_DISPLAY
#    at fork time, so exporting it afterward is too late.
if [[ ${XDG_SESSION_TYPE:-x11} != wayland ]]; then
  command -v weston >/dev/null \
    || { echo "error: install weston (sudo apt install weston)" >&2; exit 1; }
  sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$WAYLAND_SOCKET"
  if [[ ! -S $sock ]]; then
    # setsid so weston survives if rbx exits/times out — otherwise weston
    # dies, the wayland socket disappears, and waydroid's pending LXC
    # bind-mount of /run/user/$UID/wayland-1 fails (see waydroid.log).
    setsid weston --socket="$WAYLAND_SOCKET" --width=1600 --height=900 \
      </dev/null >/tmp/rbx-weston.log 2>&1 &
    disown
    for _ in {1..20}; do
      [[ -S $sock ]] && break
      sleep 0.5
    done
    [[ -S $sock ]] \
      || { echo "error: weston did not create $sock within 10s (see /tmp/rbx-weston.log)" >&2; exit 1; }
  fi
  export WAYLAND_DISPLAY=$WAYLAND_SOCKET
fi

# 4. user-side session daemon. Bridges this Linux user to the Android
#    container — clipboard, input, surface creation, and `app launch` IPC
#    all go through it. `waydroid app launch` silently no-ops if the
#    session is not RUNNING, so background-start it and poll until ready.
if ! session_running; then
  # setsid + log file: first-time Android cold boot routinely takes
  # 60-120s on a T480, well past any reasonable rbx-foreground budget.
  # Detaching means a long boot doesn't get killed if rbx is Ctrl-C'd.
  setsid waydroid session start </dev/null >/tmp/rbx-session.log 2>&1 &
  disown
  for _ in {1..180}; do
    sleep 1
    session_running && break
  done
  session_running \
    || { echo "error: waydroid session did not reach RUNNING within 180s (see /tmp/rbx-session.log and /var/lib/waydroid/waydroid.log)" >&2; exit 1; }
fi

exec waydroid app launch "$PKG"
